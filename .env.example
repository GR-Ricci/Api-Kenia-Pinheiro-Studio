# Neon pooled connection string. Replace the placeholder in Vercel only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# JWT signing secret used by the existing API.
JWT_SECRET_KEY=replace-with-a-long-random-production-secret

# The existing API currently allows localhost origins only. If the frontend is
# hosted on another origin, CORS must be addressed in the API or through a
# same-origin frontend proxy; this variable is prepared for that future change.
CORS_ORIGINS=https://replace-with-frontend-domain.example
